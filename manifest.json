{
  "manifest_version": 3,
  "name": "KookTube Key Detector",
  "version": "1.3.0",
  "description": "On-device key detection for YouTube, Spotify, and SoundCloud. Western keys and Persian dastgah.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kooktube@rasnarim",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "KookTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*",
        "https://suno.com/*",
        "https://www.suno.com/*",
        "https://udio.com/*",
        "https://www.udio.com/*",
        "https://radiojavan.com/*",
        "https://www.radiojavan.com/*",
        "https://*.radiojavan.com/*",
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://vimeo.com/*",
        "https://www.vimeo.com/*",
        "https://www.mixcloud.com/*",
        "https://mixcloud.com/*",
        "https://audiomack.com/*",
        "https://www.audiomack.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*",
        "https://www.aparat.com/*",
        "https://aparat.com/*",
        "https://archive.org/*",
        "https://www.archive.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worklet.js", "pitch.js"],
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*",
        "https://suno.com/*",
        "https://www.suno.com/*",
        "https://udio.com/*",
        "https://www.udio.com/*",
        "https://radiojavan.com/*",
        "https://www.radiojavan.com/*",
        "https://*.radiojavan.com/*",
        "https://bandcamp.com/*",
        "https://*.bandcamp.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://vimeo.com/*",
        "https://www.vimeo.com/*",
        "https://www.mixcloud.com/*",
        "https://mixcloud.com/*",
        "https://audiomack.com/*",
        "https://www.audiomack.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*",
        "https://www.aparat.com/*",
        "https://aparat.com/*",
        "https://archive.org/*",
        "https://www.archive.org/*"
      ]
    }
  ]
}
